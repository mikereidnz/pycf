# Bandit security scanning configuration
# See: https://bandit.readthedocs.io/en/latest/
#
# Run all default tests *except* the ones listed under `skips`.
# We do not pin a `tests:` allow-list because pinning it would
# silently ignore any new check bandit ships in future releases
# (this previously hid B602 subprocess-shell findings).

# Skipped checks:
#   B101 - assert_used (allow assertions; used throughout)
#   B601 - paramiko_calls (we don't use paramiko)
skips:
  - B101
  - B601

# Directories to exclude from scanning (tests and generated artefacts)
exclude_dirs:
  - tests
  - env
  - docs/_build
  - build
